<!doctype html>
<html lang="en">
<head>
<meta charset="utf-8">
<meta name="viewport" content="width=device-width, initial-scale=1">
<meta name="color-scheme" content="light dark">
<title>{{ subject }}</title>
</head>
<body style="margin:0;padding:0;background:#F7F8FA;font-family:-apple-system,Segoe UI,Roboto,Helvetica,Arial,sans-serif;color:#0F1217;">
<table role="presentation" width="100%" cellpadding="0" cellspacing="0" style="background:#F7F8FA;padding:24px 12px;">
<tr><td align="center">
<table role="presentation" width="100%" cellpadding="0" cellspacing="0" style="max-width:560px;background:#FFFFFF;border:1px solid #E5E7EB;border-radius:10px;">
<tr><td style="padding:20px 24px;border-bottom:1px solid #E5E7EB;">
<span style="display:inline-block;background:#7B6CFA;background-image:linear-gradient(135deg,#6E8BFF,#9B5CF6);color:#FFFFFF;font-weight:700;font-size:14px;line-height:14px;padding:6px 7px;border-radius:8px;">&#10003;</span>
<span style="font-size:15px;font-weight:600;margin-left:8px;vertical-align:middle;">Tasky</span>
</td></tr>
<tr><td style="padding:24px;">
<p style="margin:0 0 6px;font-size:13px;color:#5E6678;">{{ headline }}</p>
<h1 style="margin:0 0 14px;font-size:20px;line-height:1.3;font-weight:600;">{{ title }}</h1>
<p style="margin:0 0 16px;font-size:14px;line-height:1.55;">Hi {{ recipient_name }},</p>
<p style="margin:0 0 16px;font-size:14px;line-height:1.55;">{{ intro }}</p>
{% if quote %}<blockquote style="margin:0 0 20px;padding:10px 14px;border-left:3px solid #D1D5DB;background:#F9FAFB;color:#374151;font-size:14px;line-height:1.5;white-space:pre-wrap;">{{ quote }}</blockquote>{% endif %}
<p style="margin:0 0 4px;">
<a href="{{ url }}" style="display:inline-block;background:#4A6CF7;color:#FFFFFF;text-decoration:none;font-weight:600;font-size:14px;padding:10px 18px;border-radius:6px;">{{ cta }}</a>
</p>
{% if note %}<p style="margin:16px 0 0;font-size:12px;line-height:1.5;color:#6B7280;">{{ note }}</p>{% endif %}
</td></tr>
<tr><td style="padding:14px 24px;border-top:1px solid #E5E7EB;font-size:12px;color:#6B7280;">
{{ when }}<br>
{{ footer }}
</td></tr>
</table>
</td></tr>
</table>
</body>
</html>
