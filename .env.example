# Copy to .env and adjust.  cp .env.example .env
# Never commit .env -- it is git-ignored and gitleaks scans every push.
# Settings marked (Phase N) are read from that phase on; they are listed now so the file
# only ever grows.

# ---------------------------------------------------------------- Core
APP_ENV=development                # development | test | production
APP_BASE_URL=http://localhost:5173
# Comma-separated. Prod: https://<app>.vercel.app (only the SSE stream is cross-origin)
CORS_ORIGINS=http://localhost:5173
# Prod: e.g. incident-desk.duckdns.org -- Caddy obtains its TLS certificate for it
API_DOMAIN=
# Trust X-Forwarded-For from Caddy so rate limits see the real client IP
FORWARDED_ALLOW_IPS=*
# Host-side default; docker compose overrides it with the in-network hostname "db".
# Supabase: postgresql+psycopg://postgres:<DB-PASSWORD>@db.<project-ref>.supabase.co:5432/postgres?sslmode=require
# Neon:     postgresql+psycopg://<user>:<password>@<host>/<db>?sslmode=require
DATABASE_URL=postgresql+psycopg://app:app@localhost:5432/incidents
LOG_LEVEL=info                     # debug | info | warning | error
# Baked into the image at build time and shown by /health. Leave unset here, or it
# would override the image's value.
# GIT_SHA=
# Prod only: lowercase GitHub user/org that owns the GHCR image
GHCR_OWNER=

# ---------------------------------------------------------------- Auth
# Production refuses to start with this default. Generate: openssl rand -hex 32
JWT_SECRET=change-me-32-bytes-minimum
ACCESS_TOKEN_MINUTES=15
REFRESH_TOKEN_DAYS=7
# Public sign-up (new accounts are members). false = admins create accounts.
ALLOW_SELF_REGISTER=true           # false: only a team's admins can create accounts
DEMO_MODE=false                    # true: one-click demo logins on the sign-in page (public password)
# Secure refresh cookie. Empty = automatic (off only when APP_ENV=development).
COOKIE_SECURE=

# ---------------------------------------------------------------- Google sign-in (optional)
# Off unless both are set. console.cloud.google.com -> APIs & Services -> Credentials ->
# Create credentials -> OAuth client ID -> Web application. Authorised redirect URI:
#   <APP_BASE_URL>/api/v1/auth/google/callback   (locally http://localhost:5173/api/v1/auth/google/callback)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# Only if the redirect URI differs from APP_BASE_URL + /api/v1/auth/google/callback
GOOGLE_REDIRECT_URI=

# ---- Copy accounts into Supabase Auth so they show under Authentication -> Users (optional).
# Copies only: this app keeps doing sign-in and no passwords are sent. Off unless both are set.
SUPABASE_URL=                       # https://<project-ref>.supabase.co
SUPABASE_SERVICE_ROLE_KEY=          # Project Settings -> API Keys -> service_role (secret)
SUPABASE_AUTH_SYNC_SECONDS=60       # the worker copies any missing accounts this often
# Forgot-password links work once and expire after this many minutes.
PASSWORD_RESET_MINUTES=30

# ---------------------------------------------------------------- Rate limits (per IP, per minute)
RATE_LIMIT_ENABLED=true
LOGIN_RATE_LIMIT_PER_MIN=5
REGISTER_RATE_LIMIT_PER_MIN=3
FORGOT_PASSWORD_RATE_LIMIT_PER_MIN=3

# ---------------------------------------------------------------- SLA minutes: response,resolution (Phase 4)
SLA_CRITICAL=30,240
SLA_HIGH=120,480
SLA_MEDIUM=480,1440
SLA_LOW=1440,4320

# ---------------------------------------------------------------- Email + worker
# smtp = Mailpit locally (compose); brevo/resend in production (HTTPS: EC2 blocks port 25);
# console = log instead of send (safe default when nothing is configured)
EMAIL_PROVIDER=smtp                # smtp | brevo | resend | console
EMAIL_FROM="Tasky <noreply@example.com>"
SMTP_HOST=localhost                # compose overrides with "mailpit"
SMTP_PORT=1025
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_STARTTLS=false                # true for port 587 (Gmail, Outlook, most providers)
SMTP_SSL=false                     # true for port 465 (TLS from the first byte)
EMAIL_TIMEOUT_SECONDS=10
BREVO_API_KEY=
RESEND_API_KEY=
RUN_WORKER_IN_API=false            # false on EC2: the worker has its own container
WORKER_POLL_SECONDS=5
WORKER_BATCH_SIZE=20
SLA_CHECK_SECONDS=300              # SLA breach checker interval
WORKER_STALE_SECONDS=120           # /health calls the worker "stale" after this

# ---------------------------------------------------------------- Attachments (Phase 6)
STORAGE_BACKEND=local              # local | s3 (s3 = Supabase Storage's S3 endpoint)
STORAGE_DIR=.data/attachments      # local backend only
S3_ENDPOINT=
S3_BUCKET=attachments
S3_ACCESS_KEY=
S3_SECRET_KEY=
S3_REGION=us-east-1
MAX_UPLOAD_MB=10
DOWNLOAD_URL_SECONDS=300           # signed download links expire after this

# ---------------------------------------------------------------- AI (Phase 7)
LLM_PROVIDER=none                  # none | rules (offline) | groq | gemini | ollama
LLM_API_KEY=
LLM_MODEL=llama-3.3-70b-versatile  # groq default; gemini-2.0-flash; llama3.1 for ollama
LLM_BASE_URL=                      # ollama only, e.g. http://localhost:11434/v1
AI_RATE_LIMIT_PER_MIN=10           # per user
AI_DAILY_LIMIT=500                 # LLM calls per day; then the rules answer (free)
LLM_TIMEOUT_SECONDS=20             # one retry, then the rule-based fallback

# ---------------------------------------------------------------- Observability
SENTRY_DSN=
METRICS_ENABLED=true
