# Tasky backend on EC2: production settings.
# Copy to ~/tasky/.env on the server, fill in every <...>, then: chmod 600 .env
# Never commit the filled-in file.

# ---------------------------------------------------------------- the app
APP_ENV=production
# Where people open Tasky (the frontend, e.g. on Vercel). Used in email links and Google sign-in.
APP_BASE_URL=https://<your-frontend>.vercel.app
CORS_ORIGINS=https://<your-frontend>.vercel.app
# The API's own public domain; Caddy gets an HTTPS certificate for it.
# No domain yet? Use <elastic-ip-with-dashes>.sslip.io, e.g. 13-201-45-7.sslip.io
API_DOMAIN=<api.example.com>
# Trust X-Forwarded-For from Caddy (on the private Docker network).
FORWARDED_ALLOW_IPS=*
LOG_LEVEL=info
METRICS_ENABLED=true

# ---------------------------------------------------------------- security
# Generate on the server:  openssl rand -hex 32
JWT_SECRET=<64-hex-characters>
ACCESS_TOKEN_MINUTES=15
REFRESH_TOKEN_DAYS=7
ALLOW_SELF_REGISTER=true
DEMO_MODE=false
RATE_LIMIT_ENABLED=true
LOGIN_RATE_LIMIT_PER_MIN=5
REGISTER_RATE_LIMIT_PER_MIN=3
FORGOT_PASSWORD_RATE_LIMIT_PER_MIN=3

# ---------------------------------------------------------------- database (Supabase)
# Use the SESSION POOLER string (IPv4). The direct db.<ref>.supabase.co address is IPv6
# only and EC2/Docker are IPv4 by default. Supabase -> Connect -> Session pooler, then
# change "postgresql://" to "postgresql+psycopg://":
DATABASE_URL=postgresql+psycopg://postgres.<project-ref>:<DB-PASSWORD>@aws-0-<region>.pooler.supabase.com:5432/postgres?sslmode=require

# ---------------------------------------------------------------- file storage (Supabase Storage, S3)
STORAGE_BACKEND=s3
S3_ENDPOINT=https://<project-ref>.storage.supabase.co/storage/v1/s3
S3_REGION=<storage-region, e.g. us-east-1>
S3_BUCKET=attachments
S3_ACCESS_KEY=<storage-access-key-id>
S3_SECRET_KEY=<storage-secret-access-key>
MAX_UPLOAD_MB=10
DOWNLOAD_URL_SECONDS=300

# ---------------------------------------------------------------- email (Gmail SMTP)
EMAIL_PROVIDER=smtp
EMAIL_FROM="Tasky <you@gmail.com>"
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_STARTTLS=true
SMTP_SSL=false
SMTP_USERNAME=<you@gmail.com>
SMTP_PASSWORD=<16-character Google app password>
EMAIL_TIMEOUT_SECONDS=10

# ---------------------------------------------------------------- worker
RUN_WORKER_IN_API=false
WORKER_POLL_SECONDS=5
WORKER_BATCH_SIZE=20
SLA_CHECK_SECONDS=300
WORKER_STALE_SECONDS=120

# ---------------------------------------------------------------- Google sign-in (optional)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# Default is APP_BASE_URL + /api/v1/auth/google/callback; add exactly that URL in the
# Google console under "Authorised redirect URIs".
GOOGLE_REDIRECT_URI=

# ---------------------------------------------------------------- Supabase Auth copy (optional)
SUPABASE_URL=https://<project-ref>.supabase.co
SUPABASE_SERVICE_ROLE_KEY=
SUPABASE_AUTH_SYNC_SECONDS=60

# ---------------------------------------------------------------- AI (optional)
LLM_PROVIDER=rules
LLM_API_KEY=
AI_RATE_LIMIT_PER_MIN=10
AI_DAILY_LIMIT=500

# ---------------------------------------------------------------- SLA targets (response,resolution minutes)
SLA_CRITICAL=30,240
SLA_HIGH=120,480
SLA_MEDIUM=480,1440
SLA_LOW=1440,4320

# ---------------------------------------------------------------- only with --profile local-db
# POSTGRES_PASSWORD=<long-random-password>
# DATABASE_URL=postgresql+psycopg://tasky:<same-password>@db:5432/tasky
